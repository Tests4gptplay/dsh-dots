{
  "name": "dsh-dots",
  "version": "2.0.1-test.6",
  "description": "在 DeepSeek Harness 中使用 ChatGPT Dots，并通过可选 MCP 连接让 Dot 操作 DSH 会话、工具与工作区。",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/dots-ring.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./assets/dots-ring.svg",
  "files": [
    "lib/host.js",
    "lib/client.js",
    "lib/persistence.mjs",
    "lib/persistence-after-exit.mjs",
    "assets/dots-ring.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SPONSOR.md",
    "LICENSE",
    "lib/mcp-control.mjs",
    "lib/mcp-adapter.mjs",
    "lib/mcp-server.mjs",
    "THIRD-PARTY-NOTICES.txt",
    "lib/tunnel-control.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "python3 -m unittest discover -s tests/browser -p 'test_*.py'",
    "pack:check": "node scripts/verify-pack.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "react": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-dots.git"
  },
  "homepage": "https://github.com/Tests4gptplay/dsh-dots#readme",
  "license": "MIT",
  "author": "Tests4gptplay",
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-dots/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "chatgpt",
    "dots",
    "browser",
    "webview",
    "mcp"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "jsdom": "31.0.0",
    "fflate": "0.8.3"
  }
}
